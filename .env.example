# Copy to .env.local for a local, single-server workspace.
CAREGRID_ORIGIN=http://127.0.0.1:3001
CAREGRID_DB_PATH=data/caregrid.sqlite
# Only for an app bound to 127.0.0.1; disable before network deployment.
CAREGRID_ALLOW_LOCAL_SETUP=true
# Network deployments require an operator-generated random setup token.
# CAREGRID_SETUP_TOKEN=
# Optional operational data-flow policy. When omitted, CareGrid does not infer stale-device status.
# CAREGRID_DEVICE_FRESHNESS_HOURS=24

# ThingsBoard device engine: server-only values; never use NEXT_PUBLIC_ variables.
THINGSBOARD_URL=
THINGSBOARD_USERNAME=
THINGSBOARD_PASSWORD=
# One-time secret issued by CareGrid for thingsboard-adapter.
CAREGRID_THINGSBOARD_SECRET=
THINGSBOARD_SYNC_HOURS=24
