# Copy to .env.local for a local, single-server workspace.
CAREGRID_ORIGIN=http://127.0.0.1:3001
CAREGRID_DB_PATH=data/caregrid.sqlite
# Only for an app bound to 127.0.0.1; disable before network deployment.
CAREGRID_ALLOW_LOCAL_SETUP=true
# Network deployments require an operator-generated random setup token.
# CAREGRID_SETUP_TOKEN=
